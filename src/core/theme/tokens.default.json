    "scale": {
        "space": {
            "0": "0px",
            "1": "2px",
            "2": "4px",
            "3": "8px",
            "4": "12px",
            "5": "16px",
            "6": "24px",
            "7": "32px",
            "8": "48px",
            "9": "64px",
            "10": "96px"
        },
        "size": {
            "1": "16px",
            "2": "20px",
            "3": "24px",
            "4": "28px",
            "5": "32px",
            "6": "36px",
            "7": "44px",
            "8": "56px"
        }
    },
    "font": {
        "family": {
            "sans": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
            "serif": "Georgia, 'Times New Roman', serif",
            "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
        },
        "size": {
            "1": "0.75rem",
            "2": "0.875rem",
            "3": "1rem",
            "4": "1.125rem",
            "5": "1.25rem",
            "6": "1.5rem",
            "7": "1.875rem",
            "8": "2.25rem"
        },
        "weight": {
            "regular": "400",
            "medium": "500",
            "bold": "700"
        },
        "leading": {
            "tight": "1.2",
            "normal": "1.5",
            "loose": "1.75"
        }
    },
    "color": {
        "surface": {
            "base": "{palette.white}",
            "raised": "{palette.white}",
            "sunken": "{palette.neutral.50}",
            "overlay": "{palette.white}"
        },
        "text": {
            "base": "{palette.neutral.900}",
            "muted": "{palette.neutral.600}",
            "inverse": "{palette.white}",
            "disabled": "{palette.neutral.400}"
        },
        "border": {
            "base": "{palette.neutral.200}",
            "strong": "{palette.neutral.400}"
        },
        "focus": "{color.accent.base}",
        "neutral": {
            "base": "{palette.neutral.700}",
            "soft": "{palette.neutral.100}",
            "on": "{palette.white}"
        },
        "accent": {
            "base": "{palette.blue.600}",
            "soft": "{palette.blue.100}",
            "on": "{palette.white}"
        },
        "danger": {
            "base": "{palette.red.600}",
            "soft": "{palette.red.100}",
            "on": "{palette.white}"
        },
        "warning": {
            "base": "{palette.amber.500}",
            "soft": "{palette.amber.100}",
            "on": "{palette.neutral.950}"
        },
        "success": {
            "base": "{palette.green.700}",
            "soft": "{palette.green.100}",
            "on": "{palette.white}"
        },
        "info": {
            "base": "{palette.teal.700}",
            "soft": "{palette.teal.100}",
            "on": "{palette.white}"
        },
        "backdrop": "rgba(9, 9, 11, 0.5)",
        "data": {
            "categorical": {
                "1": "{palette.green.600}",
                "2": "{palette.violet.500}",
                "3": "{palette.red.700}",
                "4": "{palette.blue.600}",
                "5": "{palette.amber.900}",
                "6": "{palette.teal.700}",
                "7": "{palette.amber.600}",
                "8": "{palette.neutral.500}"
            },
            "sequential": {
                "1": "{palette.blue.500}",
                "2": "{palette.blue.600}",
                "3": "{palette.blue.700}",
                "4": "{palette.blue.800}",
                "5": "{palette.blue.900}",
                "6": "{palette.blue.950}",
                "7": "{palette.black}"
            },
            "diverging": {
                "neg3": "{palette.red.800}",
                "neg2": "{palette.red.600}",
                "neg1": "{palette.red.500}",
                "zero": "{palette.neutral.500}",
                "pos1": "{palette.blue.500}",
                "pos2": "{palette.blue.600}",
                "pos3": "{palette.blue.800}"
            }
        }
    },
    "space": {
        "inset": {
            "sm": "calc({scale.space.3} * {density.factor})",
            "md": "calc({scale.space.4} * {density.factor})",
            "lg": "calc({scale.space.5} * {density.factor})"
        },
        "gap": {
            "sm": "calc({scale.space.2} * {density.factor})",
            "md": "calc({scale.space.3} * {density.factor})",
            "lg": "calc({scale.space.4} * {density.factor})"
        },
        "stack": {
            "sm": "calc({scale.space.5} * {density.factor})",
            "md": "calc({scale.space.6} * {density.factor})",
            "lg": "calc({scale.space.7} * {density.factor})"
        }
    },
    "size": {
        "control": {
            "sm": "{scale.size.5}",
            "md": "{scale.size.6}",
            "lg": "{scale.size.7}"
        },
        "icon": {
            "sm": "{scale.size.1}",
            "md": "{scale.size.2}",
            "lg": "{scale.size.3}"
        }
    },
    "icon": {
        "stroke": "2"
    },
    "radius": {
        "none": "0",
        "sm": "4px",
        "md": "6px",
        "lg": "12px",
        "full": "9999px"
    },
    "border": {
        "width": {
            "thin": "1px",
            "thick": "2px"
        }
    },
    "elevation": {
        "flat": {
            "shadow": "none",
            "layer": "0"
        },
        "raised": {
            "shadow": "0 1px 3px 0 rgba(9, 9, 11, 0.12)",
            "layer": "1"
        },
        "overlay": {
            "shadow": "0 8px 24px 0 rgba(9, 9, 11, 0.16)",
            "layer": "10"
        },
        "modal": {
            "shadow": "0 16px 48px 0 rgba(9, 9, 11, 0.24)",
            "layer": "20"
        }
    },
    "text": {
        "display": {
            "family": "{font.family.sans}",
            "size": "{font.size.8}",
            "weight": "{font.weight.bold}",
            "leading": "{font.leading.tight}"
        },
        "title": {
            "family": "{font.family.sans}",
            "size": "{font.size.6}",
            "weight": "{font.weight.bold}",
            "leading": "{font.leading.tight}"
        },
        "heading": {
            "family": "{font.family.sans}",
            "size": "{font.size.5}",
            "weight": "{font.weight.medium}",
            "leading": "{font.leading.tight}"
        },
        "body": {
            "family": "{font.family.sans}",
            "size": "{font.size.3}",
            "weight": "{font.weight.regular}",
            "leading": "{font.leading.normal}"
        },
        "label": {
            "family": "{font.family.sans}",
            "size": "{font.size.2}",
            "weight": "{font.weight.medium}",
            "leading": "{font.leading.normal}"
        },
        "caption": {
            "family": "{font.family.sans}",
            "size": "{font.size.1}",
            "weight": "{font.weight.regular}",
            "leading": "{font.leading.normal}"
        },
        "code": {
            "family": "{font.family.mono}",
            "size": "{font.size.2}",
            "weight": "{font.weight.regular}",
            "leading": "{font.leading.normal}"
        }
    },
    "motion": {
        "duration": {
            "fast": "100ms",
            "base": "200ms",
            "slow": "400ms"
        },
        "easing": {
            "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
            "enter": "cubic-bezier(0, 0, 0.2, 1)",
            "exit": "cubic-bezier(0.4, 0, 1, 1)"
        }
    },
    "density": {
        "factor": "1",
        "compact": "0.75",
        "comfortable": "1",
        "spacious": "1.25"
    },
    "focus": {
        "width": "2px",
        "offset": "2px"
    }
}
