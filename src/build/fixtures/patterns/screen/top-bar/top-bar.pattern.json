{
    "summary": "A title bar over the content of a screen",
    "purposes": ["put a title bar over the content", "frame a screen with a header", "show the app name at the top"],
    "tree": {
        "component": "stack",
        "children": {
            "header": { "component": "stack", "children": { "title": { "component": "caption", "_text": "App" } } },
            "content": { "component": "stack" }
        }
    },
    "slots": { "actions": { "path": "children.header.children", "description": "Buttons beside the title" } },
    "params": { "title": { "type": "string", "default": "App", "paths": ["children.header.children.title._text"], "description": "The app name" } }
}
